# Postgres password used by the bundled db service (compose.yml).
POSTGRES_PASSWORD=change-me
# Connection string the app uses. With compose, the host is the db service.
DATABASE_URL=postgres://ccc:change-me@db:5432/ccc
# Owner login for the UI. At least 12 characters.
CCC_ADMIN_PASSWORD=change-me-to-something-long
# Public HTTPS URL agents and the browser use, e.g. https://ccc.example.com
CCC_PUBLIC_URL=http://localhost:8080
